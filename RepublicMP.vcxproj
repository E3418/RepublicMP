    <OutDir>$(SolutionDir)..\build\plugins\</OutDir>
    <IntDir>$(SolutionDir)obj\$(Configuration)\$(Platform)\</IntDir>
    <TargetName>RepublicMP</TargetName>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|Win32'">
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <!-- SDLCheck off: it flags strncpy as "unsafe" at compile time
           (error, not warning) - all our strncpy calls already bound the
           buffer explicitly (outBufSize-1), see detect_spawn.cpp. -->
      <SDLCheck>false</SDLCheck>
      <PreprocessorDefinitions>WIN32;_DEBUG;_WINDOWS;_USRDLL;_CRT_SECURE_NO_WARNINGS;NOMINMAX;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <ConformanceMode>true</ConformanceMode>
      <!-- /utf-8: string literals (Logf/SaveStatus) compile as real UTF-8
           instead of the ANSI code page - needed for the status console. -->
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <!-- ..\src - so #include "tesmio_plugin.h" resolves without a manual
           relative path (TesmioLoader\src, one level above this project).
           third_party\imgui(\backends) - vendored Dear ImGui 1.92.8, see
           hooks\imgui_hook.cpp. third_party\imrad - single-header ImRAD
           runtime support lib (ImRad::HBox etc.), used by ui\main_menu.cpp
           to reuse the layout designed in the ImRAD editor. -->
      <AdditionalIncludeDirectories>..\src;third_party\imgui;third_party\imgui\backends;third_party\imrad;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <!-- /MTd - static CRT, so the plugin needs no vcruntime redistributables
           alongside SOVIET64.exe. -->
      <RuntimeLibrary>MultiThreadedDebug</RuntimeLibrary>
    </ClCompile>
